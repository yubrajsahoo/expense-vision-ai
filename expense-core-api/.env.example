# Active Spring Profile (local, dev, or prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
PORT=8080

# Production PostgreSQL Database Configuration (used with 'prod' profile)
DB_URL=jdbc:postgresql://localhost:5432/expensedb
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# File Upload Limits
SERVLET_MAX_FILE_SIZE=10MB
SERVLET_MAX_REQUEST_SIZE=10MB
